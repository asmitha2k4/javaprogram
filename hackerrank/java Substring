import java.util.*;

public class Solution {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        String s = sc.next();
        int start = sc.nextInt();
        int end = sc.nextInt();

        // DO NOT add +1 here
        System.out.println(s.substring(start, end));

        sc.close();
    }
}
